{
  "name": "@shadcn-ui-svelte/components",
  "version": "0.1.0",
  "description": "A 1:1 port of shadcn/ui to Svelte 5",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/shadcn.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "svelte": "./src/index.ts",
  "scripts": {
    "build": "svelte-kit sync && svelte-package",
    "dev": "svelte-package --watch",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "shadcn",
    "ui",
    "components",
    "tailwindcss",
    "svelte5"
  ],
  "author": "Sony AK <sony@sony-ak.com>",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "sveltekit": "^2.0.0"
  }
}
